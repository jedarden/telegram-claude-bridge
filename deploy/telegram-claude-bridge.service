[Unit]
Description=Telegram-Claude Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WatchdogSec=60
User=coding
ExecStart=/home/coding/telegram-claude-bridge/bin/bridge
WorkingDirectory=/home/coding/telegram-claude-bridge
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
ExecStopPost=/home/coding/telegram-claude-bridge/scripts/bridge-crash-alert.sh
Environment=PATH=/home/coding/.local/bin:/home/coding/local/go/bin:/usr/bin:/bin
Environment=HOME=/home/coding
Environment=REPO_PATH=/home/coding/telegram-claude-bridge
Environment=BINARY_PATH=bin/bridge
Environment=PROXY_URL=http://telegram-proxy:8080
Environment=UPDATE_INTERVAL_MINUTES=5
Environment=ADMIN_CHAT_ID=0

[Install]
WantedBy=multi-user.target
