[Unit]
Description=Telegram-Claude Bridge
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=notify
WatchdogSec=60
User=coding
ExecStart=/home/coding/.telegram-claude-bridge-deploy/bin/bridge
WorkingDirectory=/home/coding/.telegram-claude-bridge-deploy
Restart=on-failure
RestartSec=5
ExecStopPost=/home/coding/.telegram-claude-bridge-deploy/scripts/bridge-crash-alert.sh
Environment=PATH=/home/coding/.local/bin:/home/coding/local/go/bin:/usr/bin:/bin
Environment=HOME=/home/coding
Environment=REPO_PATH=/home/coding/.telegram-claude-bridge-deploy
Environment=BINARY_PATH=bin/bridge
Environment=PROXY_URL=http://telegram-proxy:8080
Environment=UPDATE_INTERVAL_MINUTES=5
Environment=ADMIN_CHAT_ID=0
Environment=MAX_GLOBAL_WORKERS=30

[Install]
WantedBy=multi-user.target
