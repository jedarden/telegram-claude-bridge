name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  REGISTRY: ghcr.io

jobs:
  ci:
    name: Build & Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Vet
        run: go vet ./...

      - name: Test
        run: go test ./...

      - name: Build proxy
        run: |
          VERSION=$(git describe --tags --always 2>/dev/null || echo "dev")
          COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
          BUILDDATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          CGO_ENABLED=0 go build \
            -ldflags "-s -w -X main.Version=${VERSION} -X main.CommitSHA=${COMMIT} -X main.BuildDate=${BUILDDATE}" \
            -o proxy ./cmd/proxy/

      - name: Build bridge
        run: |
          VERSION=$(git describe --tags --always 2>/dev/null || echo "dev")
          COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
          BUILDDATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          CGO_ENABLED=0 go build \
            -ldflags "-s -w -X main.Version=${VERSION} -X main.CommitSHA=${COMMIT} -X main.BuildDate=${BUILDDATE}" \
            -o bridge ./cmd/bridge/

  docker:
    name: Build & Push Image
    runs-on: ubuntu-latest
    needs: ci
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    permissions:
      contents: read
      packages: write
    outputs:
      image: ${{ steps.image.outputs.name }}
    steps:
      - uses: actions/checkout@v4

      - name: Compute image name (lowercase)
        id: image
        run: |
          NAME=$(echo "${{ env.REGISTRY }}/${{ github.repository }}/proxy" | tr '[:upper:]' '[:lower:]')
          echo "name=$NAME" >> "$GITHUB_OUTPUT"

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ${{ steps.image.outputs.name }}:${{ github.sha }}
            ${{ steps.image.outputs.name }}:latest
          build-args: |
            VERSION=${{ github.ref_name }}
            COMMIT=${{ github.sha }}

  update-config:
    name: Update Declarative Config
    runs-on: ubuntu-latest
    needs: docker
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    steps:
      - name: Update image tag in declarative-config repo
        env:
          TOKEN: ${{ secrets.DECLARATIVE_CONFIG_TOKEN }}
          # Set DECLARATIVE_CONFIG_REPO to owner/repo of your ArgoCD config repo,
          # e.g. "jedarden/ardenone-cluster"
          REPO: ${{ vars.DECLARATIVE_CONFIG_REPO }}
          # Optional: set to the specific YAML file path to update, e.g.
          # "apps/telegram-claude-bridge/deployment.yaml"
          # If unset, all YAML files referencing the image are updated.
          IMAGE_PATH: ${{ vars.DECLARATIVE_CONFIG_IMAGE_PATH }}
          IMAGE: ${{ needs.docker.outputs.image }}
          COMMIT_SHA: ${{ github.sha }}
        run: |
          if [[ -z "$TOKEN" || -z "$REPO" ]]; then
            echo "Skipping config update: DECLARATIVE_CONFIG_TOKEN or DECLARATIVE_CONFIG_REPO not configured"
            exit 0
          fi

          git clone "https://x-access-token:${TOKEN}@github.com/${REPO}.git" config-repo
          cd config-repo

          NEW_TAG="${COMMIT_SHA}"

          if [[ -n "$IMAGE_PATH" ]]; then
            sed -i "s|${IMAGE}:[^ ]*|${IMAGE}:${NEW_TAG}|g" "$IMAGE_PATH"
          else
            grep -rl "${IMAGE}" --include="*.yaml" --include="*.yml" | \
              xargs sed -i "s|${IMAGE}:[^ ]*|${IMAGE}:${NEW_TAG}|g"
          fi

          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          if git diff --cached --quiet; then
            echo "No changes to commit"
          else
            git commit -m "chore: update proxy image to ${COMMIT_SHA::7}"
            git push
          fi
