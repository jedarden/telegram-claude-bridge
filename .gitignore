# Built binaries
bin/
/bridge
/proxy
/dashboard

# Database files
*.db
*.db-shm
*.db-wal
*.db.sender

# Temp files
/tmp/

# Worker execution traces can contain raw tool output (credentials) — never
# commit (see 2026-07-25 GH_TOKEN leak, 2026-08-22 CF token leak). The
# durable record is .beads/checkpoint/.
.beads/traces/
.beads/events.jsonl
.beads/heartbeats.jsonl

# Runtime logs can contain full upstream URLs, chat content, and credentials.
logs/
*.log

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
